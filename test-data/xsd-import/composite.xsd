<?xml version="1.0" encoding="UTF-8"?>
<!-- Composite entry schema (its own targetNamespace declares nothing). It pulls
     in the root element's declaration via a resolvable xs:import, but also
     carries an UNRESOLVABLE import hint (classpath: scheme) for a namespace it
     does not need to load. Per XSD 1.0 Part 1 the import schemaLocation is only a
     hint; the unresolvable one must be skipped, not abort the build. Regression
     for: composite schemas whose root element lives in an imported schema. -->
<schema targetNamespace="urn:aggregate"
        xmlns="http://www.w3.org/2001/XMLSchema"
        version="1.0">
  <import namespace="urn:unresolvable"
          schemaLocation="classpath:/schema/does-not-exist.xsd"/>
  <import namespace="urn:inner" schemaLocation="inner.xsd"/>
</schema>
